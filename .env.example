# Copy this file to .env and fill in the values. NEVER commit the real .env file.
# Only needed for deploying to the Sepolia test network. Local work needs nothing here.

# RPC endpoint for Sepolia (for example from Alchemy, Infura or a public endpoint)
SEPOLIA_RPC_URL=https://sepolia.example-rpc-provider.com/your-api-key

# Private key of a TEST wallet funded with Sepolia ETH. Never use a wallet that holds real funds.
PRIVATE_KEY=0xyour_test_wallet_private_key

# Optional: only for `npm run verify:sepolia` (publishes your contract code on Etherscan).
# Free key from https://etherscan.io/myapikey
ETHERSCAN_API_KEY=your_etherscan_api_key

# Optional: only for `npm run multisig:sepolia` (hands the admin role to a shared multisig; see README "Safer admin").
# Comma-separated addresses of the signers (use real, separate wallets):
# MULTISIG_OWNERS=0xSignerOne,0xSignerTwo,0xSignerThree
# How many signers must approve each action (default 2):
# MULTISIG_THRESHOLD=2
# Waiting time, in seconds, between "enough approvals" and "can run" (default 86400 = 1 day):
# MULTISIG_DELAY_SECONDS=86400
