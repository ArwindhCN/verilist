# Copy this file to .env and fill in the values. NEVER commit the real .env file.
# Only needed for deploying to the Sepolia test network. Local work needs nothing here.

# RPC endpoint for Sepolia (for example from Alchemy, Infura or a public endpoint)
SEPOLIA_RPC_URL=https://sepolia.example-rpc-provider.com/your-api-key

# Private key of a TEST wallet funded with Sepolia ETH. Never use a wallet that holds real funds.
PRIVATE_KEY=0xyour_test_wallet_private_key
